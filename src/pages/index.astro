---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const allProjects = await getCollection("projects");
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title="Nadia | Portfolio & Blog" description="Welcome to Nadia's personal portfolio and blog.">

  <!-- ── Hero ──────────────────────────── -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-grid">
        <div class="hero-text">
          <div class="hero-badge">
            <span class="badge-dot"></span>
            Open to new projects
          </div>
          <h1 class="hero-title">
            Hi, I'm <mark class="highlight">Nadia</mark> 👋
          </h1>
          <p class="hero-desc">
            Content manager specializing in AI-driven content, UX writing, and
            content strategy. I help brands be seen, heard, and remembered —
            blending editorial craft with modern AI workflows.
          </p>
          <div class="hero-ctas">
            <a href={`${base}/blog`} class="btn">Read my blog</a>
            <a href="#portfolio" class="btn btn-ghost">View projects</a>
            <a href="#about" class="btn btn-ghost">About me</a>
          </div>
        </div>
        <div class="hero-photo">
          <img src={`${base}/nadia.png`} alt="Portrait of Nadia Safarkhani" class="hero-photo-img" width="220" height="220" />
        </div>
      </div>
    </div>
    <div class="hero-ticker" aria-hidden="true">
      <span>Portfolio</span><span>·</span>
      <span>Blog</span><span>·</span>
      <span>Astro</span><span>·</span>
      <span>GitHub Pages</span><span>·</span>
      <span>Markdown</span><span>·</span>
      <span>Portfolio</span><span>·</span>
      <span>Blog</span><span>·</span>
      <span>Astro</span><span>·</span>
      <span>GitHub Pages</span><span>·</span>
      <span>Markdown</span><span>·</span>
    </div>
  </section>

  <!-- ── About ─────────────────────────── -->
  <section id="about" class="section container">
    <div class="section-head">
      <h2>About</h2>
      <p class="section-sub">Content strategist blending editorial craft with AI-powered workflows.</p>
    </div>
    <div class="about-grid">
      <p class="about-summary">
        Content writer and strategist with a background in English Literature and experience in
        technology writing, SEO, copywriting, scriptwriting, and content marketing. After beginning
        my career as a remote tech writer, I progressed as a content team head, managing editorial
        teams and developing content strategies. More recently, I have specialized in AI-powered
        content operations, building automated workflows, working with AI agents, and integrating
        generative AI into content production. I combine editorial expertise, strategic thinking,
        and modern AI tools to help teams create high-quality content efficiently, whether
        human-written, AI-generated, or a blend of both.
      </p>
      <div class="about-tools">
        <h3 class="about-tools-title">Tools I've worked with</h3>
        <ul class="tags">
          <li class="tag">Claude Code</li>
          <li class="tag">ChatGPT</li>
          <li class="tag">Gemini</li>
          <li class="tag">HeyGen</li>
          <li class="tag">Higgsfield</li>
          <li class="tag">OpenClaw</li>
          <li class="tag">GitHub</li>
          <li class="tag">Google Analytics</li>
          <li class="tag">Google Search Console</li>
          <li class="tag">SemRush</li>
          <li class="tag">SocialChamp</li>
          <li class="tag">Canva</li>
          <li class="tag">Adobe Photoshop</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ── Experience ────────────────────── -->
  <section id="experience" class="section container">
    <div class="section-head">
      <h2>Experience</h2>
      <p class="section-sub">Where I've grown as a writer, editor, and content strategist.</p>
    </div>
    <div class="timeline">
      <article class="timeline-item">
        <div class="timeline-header">
          <div>
            <h3 class="timeline-role">Content Manager & AI Content Owner</h3>
            <p class="timeline-company">Cloudzy</p>
          </div>
          <span class="timeline-dates">09/2025 – Present</span>
        </div>
        <ul class="timeline-list">
          <li>Partner with the SEO team to develop search-driven content strategies and produce high-performing blog articles.</li>
          <li>Review, edit, and mentor writers to maintain editorial quality, consistency, tone of voice, and brand standards.</li>
          <li>Monitor website and blog performance using analytics to identify content gaps, optimize existing pages, and guide future content decisions.</li>
          <li>Design and implement AI-powered content workflows using Claude Code, ChatGPT, Gemini, and AI agents, significantly reducing manual effort and accelerating content production.</li>
          <li>Generate social media graphics and videos using HeyGen, Higgsfield, Claude Design, Midjourney, Grok, ChatGPT, and Gemini.</li>
        </ul>
      </article>

      <article class="timeline-item">
        <div class="timeline-header">
          <div>
            <h3 class="timeline-role">Senior Content Writer & Head of Intl. Content Team</h3>
            <p class="timeline-company">Ronix Tools</p>
          </div>
          <span class="timeline-dates">03/2022 – 09/2025</span>
        </div>
        <ul class="timeline-list">
          <li>Collaborated with the SEO team to optimize the company's websites on search engines.</li>
          <li>Monitored and provided feedback on the international content team's projects.</li>
          <li>Wrote blog posts and press releases announcing company news, generating positive media coverage across various outlets.</li>
          <li>Developed creative and engaging copy for various marketing campaigns.</li>
        </ul>
      </article>

      <article class="timeline-item">
        <div class="timeline-header">
          <div>
            <h3 class="timeline-role">Content Marketing Expert | SEO Junior</h3>
            <p class="timeline-company">Ordibeheesht | Digital Marketing Agency</p>
          </div>
          <span class="timeline-dates">05/2021 – 02/2022</span>
        </div>
        <ul class="timeline-list">
          <li>Wrote SEO-friendly content for clients' websites and blog posts to increase organic traffic.</li>
          <li>Performed keyword research to optimize content for SEO.</li>
          <li>Wrote social media content for clients based on their brand's vision and voice.</li>
          <li>Created pay-per-click campaigns to drive targeted traffic to clients' websites.</li>
          <li>Tracked market trends to stay current on consumer and competitor changes.</li>
        </ul>
      </article>
    </div>

    <div class="earlier">
      <h3 class="earlier-title">Earlier Experience</h3>
      <ul class="earlier-list">
        <li class="earlier-row">
          <span class="earlier-role">English as a Second Language Teacher</span>
          <span class="earlier-company">Language Institutes</span>
          <span class="earlier-dates">01/2019 – 01/2021</span>
        </li>
        <li class="earlier-row">
          <span class="earlier-role">Content Writer & Translator</span>
          <span class="earlier-company">Freelance</span>
          <span class="earlier-dates">08/2017 – 08/2019</span>
        </li>
        <li class="earlier-row">
          <span class="earlier-role">Web Content Writer & Journalist</span>
          <span class="earlier-company">FaceIt</span>
          <span class="earlier-dates">01/2016 – 06/2017</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ── Portfolio ─────────────────────── -->
  <section id="portfolio" class="section container">
    <div class="section-head">
      <h2>Portfolio</h2>
      <p class="section-sub">A selection of projects I've been working on.</p>
    </div>
    <div class="grid">
      {
        projects.map((project) => (
          <article class="card project-card">
            <div class="card-body">
              <h3 class="card-title">{project.data.title}</h3>
              <p class="card-desc">{project.data.description}</p>
            </div>
            <footer class="card-footer">
              <ul class="tags">
                {project.data.tags.map((tag) => (
                  <li class="tag">{tag}</li>
                ))}
              </ul>
              {(project.data.repoUrl || project.data.demoUrl) && (
                <div class="card-links">
                  {project.data.repoUrl && (
                    <a href={project.data.repoUrl} class="card-link">
                      ↗ Repo
                    </a>
                  )}
                  {project.data.demoUrl && (
                    <a href={project.data.demoUrl} class="card-link">
                      ↗ Demo
                    </a>
                  )}
                </div>
              )}
            </footer>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ── Languages & Education ─────────── -->
  <section id="education" class="section container">
    <div class="section-head">
      <h2>Languages & Education</h2>
    </div>
    <div class="info-grid">
      <div class="info-card card">
        <h3>Languages</h3>
        <ul class="lang-list">
          <li class="lang-row"><span>English</span><span class="lang-level">C2 · Proficient</span></li>
          <li class="lang-row"><span>Persian</span><span class="lang-level">C2 · Native</span></li>
          <li class="lang-row"><span>German</span><span class="lang-level">B1 · Intermediate</span></li>
        </ul>
      </div>
      <div class="info-card card">
        <h3>Education & Certifications</h3>
        <p class="edu-degree">Bachelor of Arts (B.A.), English Language and Literature</p>
        <p class="edu-meta">National University · 2012 – 2016</p>
        <ul class="cert-list">
          <li>Content Marketing: Distribution Strategy — LinkedIn Learning</li>
          <li>Content Strategy for Marketers — LinkedIn Learning</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ── Blog ──────────────────────────── -->
  <section class="section container">
    <div class="section-head">
      <h2>Latest Posts</h2>
      <p class="section-sub">Short notes, updates, and learnings.</p>
    </div>
    <div class="post-list">
      {
        posts.map((post) => (
          <a
            href={`${base}/blog/${post.id}`}
            class="post-row"
          >
            <time class="post-date">
              {post.data.pubDate.toLocaleDateString("en-US", { dateStyle: "medium" })}
            </time>
            <div class="post-center">
              <p class="post-title">{post.data.title}</p>
              <p class="post-desc">{post.data.description}</p>
            </div>
            <span class="post-arrow">→</span>
          </a>
        ))
      }
    </div>
    <div class="view-all">
      <a href={`${base}/blog`} class="btn">All posts →</a>
    </div>
  </section>

</Layout>

<style>
  /* ── Hero ──────────────────────────── */
  .hero {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .hero-inner {
    padding-top: 4rem;
    padding-bottom: 3rem;
  }

  .hero-grid {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: 2rem;
    text-align: center;
  }

  .hero-photo {
    display: flex;
    justify-content: center;
    flex-shrink: 0;
  }

  .hero-photo-img {
    width: 200px;
    height: 200px;
    object-fit: contain;
    filter: drop-shadow(0 10px 24px rgba(74, 68, 88, 0.18));
  }

  @media (min-width: 760px) {
    .hero-grid {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      text-align: left;
      gap: 3rem;
    }

    .hero-text {
      flex: 1;
    }

    .hero-photo-img {
      width: 240px;
      height: 240px;
    }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--cucumber-light);
    color: var(--cucumber);
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 1.25rem;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    background: var(--cucumber);
    border-radius: 50%;
    animation: blink 2s ease-in-out infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.8); }
  }

  .hero-title {
    font-size: clamp(2.6rem, 6.5vw, 4.25rem);
    margin-bottom: 1.1rem;
  }

  .highlight {
    background: var(--banana);
    color: var(--coconut);
    padding: 0.04em 0.22em;
    border-radius: 0.5em;
    font-style: normal;
  }

  .hero-desc {
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 520px;
    margin-bottom: 2.25rem;
    line-height: 1.75;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  @media (min-width: 760px) {
    .hero-ctas {
      justify-content: flex-start;
    }
  }

  /* Ticker stripe */
  .hero-ticker {
    display: flex;
    gap: 1.25rem;
    padding: 0.65rem 0;
    background: var(--banana);
    overflow: hidden;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--coconut);
    white-space: nowrap;
  }

  .hero-ticker span {
    flex-shrink: 0;
    padding-inline: 0.75rem;
  }

  /* ── Sections ──────────────────────── */
  .section-head {
    margin-bottom: 2rem;
  }

  .section-head h2 {
    font-size: 1.85rem;
    margin-bottom: 0.3rem;
  }

  .section-sub {
    color: var(--muted);
    margin: 0;
    font-size: 1rem;
  }

  /* ── About ──────────────────────────── */
  .about-grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1.4fr 1fr;
  }

  .about-summary {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.8;
    margin: 0;
  }

  .about-tools-title {
    font-size: 1rem;
    margin-bottom: 0.85rem;
  }

  @media (max-width: 760px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  /* ── Experience timeline ────────────── */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .timeline-item {
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }

  .timeline-role {
    font-size: 1.1rem;
    margin: 0 0 0.15rem;
  }

  .timeline-company {
    margin: 0;
    color: var(--cucumber);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .timeline-dates {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--muted);
    white-space: nowrap;
    background: var(--wheat);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
  }

  .timeline-list {
    margin: 0;
    padding-left: 1.2rem;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .timeline-list li {
    margin-bottom: 0.35rem;
  }

  .timeline-list li:last-child {
    margin-bottom: 0;
  }

  .earlier {
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
  }

  .earlier-title {
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }

  .earlier-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .earlier-row {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    font-size: 0.9rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border);
  }

  .earlier-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .earlier-role {
    font-weight: 700;
    color: var(--coconut);
  }

  .earlier-company {
    color: var(--muted);
  }

  .earlier-dates {
    color: var(--muted);
    font-size: 0.8rem;
    white-space: nowrap;
  }

  /* ── Languages & Education ──────────── */
  .info-grid {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .info-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .info-card h3 {
    font-size: 1.1rem;
    margin-bottom: 1rem;
  }

  .lang-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .lang-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border);
  }

  .lang-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .lang-level {
    color: var(--muted);
    font-weight: 700;
    font-size: 0.85rem;
  }

  .edu-degree {
    font-weight: 700;
    color: var(--coconut);
    margin: 0 0 0.2rem;
  }

  .edu-meta {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0 0 1rem;
  }

  .cert-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  /* ── Project cards ─────────────────── */
  .project-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .card-body {
    flex: 1;
  }

  .card-title {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }

  .card-desc {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.65;
    margin: 0;
  }

  .card-footer {
    margin-top: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .card-links {
    display: flex;
    gap: 1rem;
  }

  .card-link {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--cucumber);
  }

  .card-link:hover {
    color: var(--caramel);
  }

  /* ── Post list ─────────────────────── */
  .post-list {
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .post-row {
    display: grid;
    grid-template-columns: 130px 1fr auto;
    align-items: center;
    gap: 1.5rem;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border);
    color: var(--coconut) !important;
    transition: background var(--ease);
    text-decoration: none !important;
  }

  .post-row:last-child {
    border-bottom: none;
  }

  .post-row:hover {
    background: var(--wheat);
  }

  .post-date {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--muted);
    white-space: nowrap;
  }

  .post-title {
    font-size: 1rem;
    font-weight: 800;
    color: var(--coconut);
    margin: 0 0 0.2rem;
  }

  .post-desc {
    font-size: 0.875rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.5;
  }

  .post-arrow {
    font-size: 1.2rem;
    color: var(--muted);
    transition: transform var(--ease), color var(--ease);
  }

  .post-row:hover .post-arrow {
    transform: translateX(4px);
    color: var(--cucumber);
  }

  .view-all {
    margin-top: 1.5rem;
  }

  @media (max-width: 580px) {
    .post-row {
      grid-template-columns: 1fr auto;
    }
    .post-date {
      display: none;
    }
  }
</style>
